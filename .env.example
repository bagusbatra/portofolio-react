APP_URL="MY_APP_URL"

# SMTP credentials used by the /api/contact endpoint to send contact form emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="no-reply@bagusbatra.dev"

# Where contact form submissions are delivered (defaults to bagusbatr@gmail.com)
CONTACT_TO_EMAIL="bagusbatr@gmail.com"
